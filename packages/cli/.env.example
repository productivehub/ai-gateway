# HTTP defaults; programmatic options take precedence. Read by `serve` and the in-process CLI.
# AI_GATEWAY_CONFIG=./gateway.config.json
# CLI only: call a running server instead of the in-process API.
# AI_GATEWAY_URL=http://127.0.0.1:8787
# AI_GATEWAY_DEFAULT_PROVIDER=anthropic
AI_GATEWAY_DEFAULT_DIALECT=bridge
AI_GATEWAY_MAX_BODY_BYTES=16777216
AI_GATEWAY_HOSTNAME=127.0.0.1
AI_GATEWAY_PORT=8787

# Set keys only for the providers you use.
# Local Ollama is disabled unless its URL is configured.
# OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OLLAMA_CLOUD_API_KEY=
# Named accounts referenced by gateway.config.example.json:
ANTHROPIC_WORK_API_KEY=
ANTHROPIC_PERSONAL_API_KEY=
